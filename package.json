{
  "name": "douyin-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Douyin Vault — local-first automatic video archiver for Douyin group chats",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "concurrently -n server,web -c red,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "pnpm --filter @vault/web dev",
    "build": "pnpm --filter @vault/web build && pnpm --filter @vault/server build",
    "start": "node apps/server/dist/main.js",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "pnpm build && playwright test",
    "test:fixtures": "vitest run tests/fixtures",
    "test:live": "tsx scripts/live-check.ts",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:fixtures",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "backup": "tsx scripts/backup.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "setup-token": "tsx scripts/setup-token.ts",
    "live:preflight": "tsx scripts/live-check.ts --preflight",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "@vault/core": "workspace:*",
    "@vault/db": "workspace:*",
    "@vault/im-adapters": "workspace:*",
    "@vault/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "better-sqlite3": "^12.4.1",
    "@vault/downloader-adapters": "workspace:*",
    "zod": "^4.1.12",
    "douyin-im": "1.1.0"
  }
}
