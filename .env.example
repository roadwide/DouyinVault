# ── Douyin Vault configuration ───────────────────────────────────────────────
# Copy to .env and edit. Never commit .env or the data/ directory.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Admin session lifetime (days) and cookie policy.
SESSION_DAYS=30
# Leave false for local HTTP; true requires HTTPS (Tunnel/reverse proxy).
SECURE_COOKIES=false

# Local bind address. Keep it on loopback and put Cloudflare Tunnel in front.
HOST=127.0.0.1
PORT=18760

# All local state: database, sessions, media, temp, logs, backups.
DATA_DIR=./data

# Public origin allowed to make browser requests (CSRF origin check).
# Use the exact origin users open in the browser.
PUBLIC_ORIGIN=http://127.0.0.1:18760

# Optional: seed the admin password instead of the first-run setup token.
# Leave blank to use `pnpm setup-token`.
ADMIN_PASSWORD=

# ── IM source ────────────────────────────────────────────────────────────────
# mock        — offline development adapter (no Douyin connection)
# douyin-im   — Node IM SDK (installed as an optional workspace dependency;
#               see docs/development.md). Primary production path.
# playwright  — browser fallback (experimental; requires Chromium install)
IM_ADAPTER=mock

# Enable demo-only APIs (simulated QR scan, demo seeding).
# Demo mode is forced off in production; production also refuses the mock adapter.
DEMO_MODE=true

# ── Downloaders ──────────────────────────────────────────────────────────────
# Independent Douyin_TikTok_Download_API instance (v4 or v5). Optional.
DTK_BASE_URL=
DTK_API_KEY=
# auto | v5 | v4
DTK_MODE=auto

# yt-dlp executable (fallback downloader).
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Comma-separated extra hosts allowed for direct media download.
MEDIA_ALLOWED_HOSTS=

# ── Playwright fallback ──────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_PROFILE_DIR=./data/browser-profile
