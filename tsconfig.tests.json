{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@vault/core": ["packages/core/src/index.ts"],
      "@vault/shared": ["packages/shared/src/index.ts"],
      "@vault/db": ["packages/db/src/index.ts"],
      "@vault/im-adapters": ["packages/im-adapters/src/index.ts"],
      "@vault/downloader-adapters": ["packages/downloader-adapters/src/index.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "playwright.config.ts", "vitest.config.ts", "apps/web/vite.config.ts", "apps/server/tsup.config.ts"]
}
